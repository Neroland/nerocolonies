{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroColonies - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "accessWidener": "nerocolonies.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.nerocolonies.fabric.NeroColoniesFabric"],
    "client": ["za.co.neroland.nerocolonies.fabric.NeroColoniesFabricClient"]
  },
  "mixins": [
    "nerocolonies-common.mixins.json",
    "nerocolonies.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version}"
  },
  "suggests": {
    "nerospace": "*",
    "neroagriculture": "*",
    "nerologistics": "*",
    "neroeconomy": "*",
    "energizedpower": "*"
  }
}
